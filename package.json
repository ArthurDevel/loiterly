{
  "name": "loiterly-electron",
  "version": "0.0.4",
  "private": true,
  "license": "MIT",
  "description": "Floating Chromium workspace prototype for Loiterly",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win-helper": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-helper.ps1",
    "build:app-icon": "bash scripts/build-app-icon.sh",
    "download:icons": "bash scripts/download-app-icons.sh",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "release:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish always",
    "dist:win": "npm run build:win-helper && electron-builder --win nsis --publish never",
    "release:win": "npm run build:win-helper && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "author": "ArthurDevel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurDevel/loiterly.git"
  },
  "build": {
    "appId": "com.arthurdevel.loiterly",
    "productName": "Loiterly",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/native/bin",
        "to": "native/bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "electron/after-pack.cjs",
    "mac": {
      "icon": "electron/assets/loiterly.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "electron/assets/loiterly.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ArthurDevel",
        "repo": "loiterly"
      }
    ]
  }
}
